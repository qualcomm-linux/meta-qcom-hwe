[Unit]
Description= qrtr-filter Service
SourcePath=/usr/bin/qrtr-filter
DefaultDependencies=no

[Service]
User=qrtr
Group=qrtr
Restart=on-failure
RemainAfterExit=yes
ExecStart=/usr/bin/qrtr-filter

[Install]
WantedBy=sysinit.target
