From 432b0fb3cf4ad9dcd3c0ce25fa414a7d01965cb0 Mon Sep 17 00:00:00 2001
From: Mukesh Ojha <mukesh.ojha@oss.qualcomm.com>
Date: Fri, 24 Oct 2025 14:04:29 +0530
Subject: [PATCH 1/2] PENDING: firmware: scm: Fix mem-abort in start stop test

There is a irregularity in the way the memory is allocated for resource
table remoteproc framework in our recent resource table SMC
implementation like later use device managed one and former uses the raw
version which could result in below issue of list corruption.

~# echo stop > /sys/class/remoteproc/remoteproc0/state
~# cat /sys/class/remoteproc/remoteproc0/state
offline
root@qcs9100-ride-sx:~# echo start > /sys/class/remoteproc/remoteproc0/state
[   77.303019] Unable to handle kernel paging request at virtual address ffff000099f30000
[   77.311153] Mem abort info:

[...]

[   77.373701] Internal error: Oops: 0000000096000007 [#1] PREEMPT SMP
[   77.617163] Call trace:
[   77.619683]  __list_add_valid_or_report+0x24/0xb8
[   77.624516]  add_dr+0x54/0x108
[   77.627661]  devm_kmalloc+0xc8/0x140
[   77.631340]  qcom_scm_pas_get_rsc_table+0x48/0xb8
[   77.636173]  qcom_pas_parse_firmware+0xb4/0x128 [qcom_q6v5_pas]
[   77.642267]  rproc_boot+0x160/0x590
[   77.645856]  state_store+0x48/0x118
[   77.649444]  dev_attr_store+0x20/0x40
[   77.653212]  sysfs_kf_write+0x4c/0x68
[   77.656986]  kernfs_fop_write_iter+0x13c/0x1d8
[   77.661556]  vfs_write+0x1c8/0x320
[   77.665052]  ksys_write+0x7c/0x120
[   77.668546]  __arm64_sys_write+0x24/0x38
[   77.672583]  invoke_syscall+0x50/0x128
[   77.676443]  el0_svc_common.constprop.0+0xc8/0xf0
[   77.681282]  do_el0_svc+0x24/0x38
[   77.684688]  el0_svc+0x38/0x108
[   77.687921]  el0t_64_sync_handler+0x120/0x130
[   77.692394]  el0t_64_sync+0x190/0x198
[   77.696161] Code: b4000242 f9400442 eb01005f 54000261 (f9400041)
[   77.702423] ---[ end trace 0000000000000000 ]---
