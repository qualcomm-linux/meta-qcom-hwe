Change-Id: I311628c93a573f1517449e60adf5a852fc644f24
Signed-off-by: Mukesh Ojha <mukesh.ojha@oss.qualcomm.com>
Upstream-Status: Pending
---
 drivers/firmware/qcom_scm.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/qcom_scm.c b/drivers/firmware/qcom_scm.c
index 5e3e9c93be45..3acc0122a238 100644
--- a/drivers/firmware/qcom_scm.c
+++ b/drivers/firmware/qcom_scm.c
@@ -849,7 +849,7 @@ int qcom_scm_pas_get_rsc_table(struct qcom_scm_pas_context *ctx, void *input_rt,
 	int ret;
 
 	do {
-		*output_rt = devm_kzalloc(ctx->dev, *output_rt_size, GFP_KERNEL);
+		*output_rt = kzalloc(*output_rt_size, GFP_KERNEL);
 		if (!*output_rt)
 			return -ENOMEM;
 
@@ -857,7 +857,7 @@ int qcom_scm_pas_get_rsc_table(struct qcom_scm_pas_context *ctx, void *input_rt,
 						   input_rt_size, output_rt,
 						   output_rt_size);
 		if (ret)
-			devm_kfree(ctx->dev, *output_rt);
+			kfree(*output_rt);
 
 	} while (ret == -EAGAIN);
 
