From aad95825fc2bb29bcb93034861911aa820431727 Mon Sep 17 00:00:00 2001
From: Nirmesh Kumar Singh <nkumarsi@qti.qualcomm.com>
Date: Thu, 23 Oct 2025 12:32:00 +0530
Subject: [PATCH] QCLINUX: arm64: dts: qcom: Add msm-id & board-id for monaco
 evk

Enable DT identification support for monaco
EVK board.

Upstream-Status: Inappropriate
Signed-off-by: Nirmesh Kumar Singh <nkumarsi@qti.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/monaco-evk.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/monaco-evk.dts b/arch/arm64/boot/dts/qcom/monaco-evk.dts
index 5d931876a6e8..35a23b8b2abe 100644
--- a/arch/arm64/boot/dts/qcom/monaco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/monaco-evk.dts
@@ -15,6 +15,9 @@ / {
 	model = "Qualcomm Technologies, Inc. Monaco EVK";
 	compatible = "qcom,monaco-evk", "qcom,qcs8300";
 
+	qcom,msm-id = <675 0x10000>;
+	qcom,board-id = <0x00010020 2>, <0x00010019 2>;
+
 	aliases {
 		ethernet0 = &ethernet0;
 		i2c1 = &i2c1;
-- 
2.34.1

