+static const int mpeg_sr_base[3] = {44100, 48000, 32000};
+
+/* AAC ADTS sample rates table */
+static const int aac_sample_rates[13] = {
+    96000, 88200, 64000, 48000, 44100, 32000,
+    24000, 22050, 16000, 12000, 11025, 8000, 7350
+};
+
+/* ------- small helpers ------- */
+
+/* find a byte sequence in a buffer (portable replacement for memmem) */
+static const uint8_t *find_bytes(const uint8_t *hay, size_t hlen,
+                                 const uint8_t *needle, size_t nlen)
+{
+    if (!hay || !needle || nlen == 0 || hlen < nlen) return NULL;
+    for (size_t i = 0; i <= hlen - nlen; ++i) {
+        if (hay[i] == needle[0] && memcmp(hay + i, needle, nlen) == 0)
+            return hay + i;
+    }
+    return NULL;
+}
+
+/* Read up to max_bytes from file */
+static ssize_t read_prefix(const char *filename, uint8_t *buf, size_t max_bytes)
+{
+    int fd = open(filename, O_RDONLY);
+    if (fd < 0) return -1;
+    ssize_t r = read(fd, buf, max_bytes);
+    close(fd);
+    return r;
+}
+
+/* ------- MP3 parsing ------- */
+
+static int mp3_is_frame_start(const uint8_t *p)
+{
+    if (p[0] != 0xFF || (p[1] & 0xE0) != 0xE0) return 0;  /* 11-bit sync */
+    uint8_t version_id = (p[1] >> 3) & 0x03;  /* 3=MPEG1, 2=MPEG2, 0=MPEG2.5 */
+    uint8_t layer      = (p[1] >> 1) & 0x03;  /* 1=Layer III */
+    uint8_t bitrate_ix = (p[2] >> 4) & 0x0F;
+    uint8_t sr_ix      = (p[2] >> 2) & 0x03;
+    if (version_id == 0x01) return 0;  /* reserved */
+    if (layer != 0x01)    return 0;    /* only Layer III */
+    if (bitrate_ix == 0x0F || bitrate_ix == 0x00) return 0;
+    if (sr_ix == 0x03) return 0;
+    return 1;
+}
+
+/* Parse MP3 header to sr/ch/frame_bytes/frame_dur_us */
+static int mp3_parse_header(const uint8_t *h,
+                            uint32_t *sr, uint32_t *ch,
+                            uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    if (!mp3_is_frame_start(h)) return 0;
+
+    uint8_t version_id = (h[1] >> 3) & 0x03;      /* 3=MPEG1, 2=MPEG2, 0=MPEG2.5 */
+    uint8_t sr_ix      = (h[2] >> 2) & 0x03;
+    uint8_t bitrate_ix = (h[2] >> 4) & 0x0F;
+    uint8_t padding    = (h[2] >> 1) & 0x01;
+    uint8_t mode       = (h[3] >> 6) & 0x03;      /* 3=single channel */
+
+    /* channels */
+    *ch = (mode == 3) ? 1u : 2u;
+
+    /* derive sample rate by version */
+    int base = mpeg_sr_base[sr_ix];
+    switch (version_id) {
+        case 3: *sr = base;     break;     /* MPEG1 */
+        case 2: *sr = base / 2; break;     /* MPEG2 */
+        case 0: *sr = base / 4; break;     /* MPEG2.5 */
+        default: return 0;
+    }
+
+    /* bitrate tables for Layer III (kbps) */
+    static const int br_mpeg1_l3[16] = {
+        0, 32, 40, 48, 56, 64, 80, 96,
+        112, 128, 160, 192, 224, 256, 320, 0
+    };
+    static const int br_mpeg2_l3[16] = {
+        0, 8, 16, 24, 32, 40, 48, 56,
+        64, 80, 96, 112, 128, 144, 160, 0
+    };
+    int br_kbps = (version_id == 3) ? br_mpeg1_l3[bitrate_ix] : br_mpeg2_l3[bitrate_ix];
+    if (br_kbps == 0) return 0;
+
+    /* frame size:
+       MPEG1: 144 * br / sr + padding, samples/frame=1152
+       MPEG2/2.5: 72 * br / sr + padding, samples/frame=576 */
+    int mul = (version_id == 3) ? 144 : 72;
+    uint32_t fb = (uint32_t)((mul * (br_kbps * 1000)) / *sr) + padding;
+    *frame_bytes = fb;
+
+    uint32_t spf = (version_id == 3) ? 1152u : 576u;
+    *frame_dur_us = (uint32_t)((1000000ULL * spf) / *sr);
+    return 1;
+}
+
+static int scan_mp3(const uint8_t *buf, size_t len,
+                    uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    /* If ID3v2 present, skip it; otherwise just scan forward for sync */
+    size_t off = 0;
+    if (len >= 10 && memcmp(buf, "ID3", 3) == 0) {
+        size_t tag_size = ((buf[6] & 0x7F) << 21) |
+                          ((buf[7] & 0x7F) << 14) |
+                          ((buf[8] & 0x7F) << 7)  |
+                          (buf[9] & 0x7F);
+        off = 10 + tag_size;
+        if (off > len) off = 0; /* malformed tag -> scan from 0 */
+    }
+
+    for (size_t i = off; i + 4 <= len; ++i) {
+        if (mp3_parse_header(buf + i, sr, ch, frame_bytes, frame_dur_us))
+            return 1;
+    }
+    return 0;
+}
+
+/* ------- AAC ADTS parsing ------- */
+
+static int aac_parse_adts(const uint8_t *h,
+                          uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    if (!(h[0] == 0xFF && (h[1] & 0xF0) == 0xF0)) return 0; /* sync 0xFFF */
+
+    int sr_index = (h[2] >> 2) & 0x0F;
+    if (sr_index >= 13) return 0;
+
+    *sr = (uint32_t)aac_sample_rates[sr_index];
+    *ch = (uint32_t)(((h[2] & 0x01) << 2) | ((h[3] >> 6) & 0x03));
+    if (*ch == 0) *ch = 2; /* fallback */
+
+    uint32_t flen = ((h[3] & 0x03) << 11) | (h[4] << 3) | ((h[5] >> 5) & 0x07);
+    *frame_bytes = (flen > 0) ? flen : 1024;
+
+    *frame_dur_us = (uint32_t)((1000000ULL * 1024) / *sr); /* AAC LC */
+    return 1;
+}
+
+static int scan_aac_adts(const uint8_t *buf, size_t len,
+                         uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    for (size_t i = 0; i + 7 <= len; ++i) {
+        if (aac_parse_adts(buf + i, sr, ch, frame_bytes, frame_dur_us))
+            return 1;
+    }
+    return 0;
+}
+
+/* ------- FLAC parsing (STREAMINFO) ------- */
+
+static int parse_flac_streaminfo(const uint8_t *si, size_t silen,
+                                 uint32_t *sr, uint32_t *ch)
+{
+    if (silen < 34) return 0;
+    /* Sample rate: 20 bits starting at byte 10 */
+    uint32_t s = ((si[10] << 12) | (si[11] << 4) | ((si[12] >> 4) & 0x0F)) & 0xFFFFF;
+    uint32_t c = ((si[12] >> 1) & 0x07) + 1;
+    if (s == 0) return 0;
+    *sr = s;
+    *ch = c ? c : 2;
+    return 1;
+}
+
+static int scan_flac(const uint8_t *buf, size_t len,
+                     uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    const uint8_t magic[] = {'f','L','a','C'};
+    const uint8_t *p = find_bytes(buf, len, magic, 4);
+    if (!p) return 0;
+    if ((size_t)(p - buf) + 8 > len) return 0;
+
+    /* Metadata block header follows: [is_last|type(7), length(24)] */
+    const uint8_t *mb = p + 4;
+    uint8_t type = mb[0] & 0x7F;
+    uint32_t length = (mb[1] << 16) | (mb[2] << 8) | mb[3];
+    const uint8_t *si = mb + 4;
+
+    if (type == 0 && (size_t)(si - buf) + length <= len) {
+        if (!parse_flac_streaminfo(si, length, sr, ch)) return 0;
+        /* Block size is variable; use a conservative frame_bytes */
+        *frame_bytes = 4096;
+        *frame_dur_us = (uint32_t)((1000000ULL * 4096) / *sr);
+        return 1;
+    }
+    return 0;
+}
+
+/* ------- Opus (Ogg) ------- */
+
+static int scan_opus(const uint8_t *buf, size_t len,
+                     uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    const uint8_t sig[] = {'O','p','u','s','H','e','a','d'};
+    const uint8_t *p = find_bytes(buf, len, sig, sizeof(sig));
+    if (!p) return 0;
+    /* Opus always decodes at 48 kHz; channel count at byte 9 */
+    *sr = 48000;
+    *ch = (len >= (size_t)(p - buf + 10)) ? p[9] : 2;
+    *frame_bytes = 960; /* nominal; varies */
+    *frame_dur_us = (uint32_t)((1000000ULL * 960) / *sr);
+    return 1;
+}
+
+/* ------- Vorbis (Ogg) ------- */
+
+static int scan_vorbis(const uint8_t *buf, size_t len,
+                       uint32_t *sr, uint32_t *ch, uint32_t *frame_bytes, uint32_t *frame_dur_us)
+{
+    /* Identification header: 0x01 'vorbis' + version(4) + channels(1) + samplerate(4 LE) */
+    const uint8_t sig[] = {'v','o','r','b','i','s'};
+    const uint8_t *p = find_bytes(buf, len, sig, sizeof(sig));
+    if (!p) return 0;
+    if (p == buf) return 0;
+    if (*(p - 1) != 0x01) {
+        /* Didn't land on identification header; fallback defaults */
+        *sr = 44100; *ch = 2;
+    } else {
+        size_t pos = (size_t)(p - buf);
+        if (pos + 7 + 9 > len) { *sr = 44100; *ch = 2; }
+        else {
+            uint8_t channels = buf[pos + 7 + 4]; /* after 'vorbis' + version */
+            uint32_t samplerate = (uint32_t)(
+                buf[pos + 7 + 5]        |
+                (buf[pos + 7 + 6] << 8) |
+                (buf[pos + 7 + 7] << 16)|
+                (buf[pos + 7 + 8] << 24));
+            *sr = samplerate ? samplerate : 44100;
+            *ch = channels ? channels : 2;
+        }
+    }
+    *frame_bytes = 1024;
+    *frame_dur_us = (uint32_t)((1000000ULL * 1024) / *sr);
+    return 1;
+}
+
+/* ------- Main detector ------- */
+
+static int detect_compressed_format(struct data *data, const char *filename)
+{
+    enum { MAX_SCAN = 1024 * 1024 }; /* scan up to 1MB */
+    uint8_t *buf = (uint8_t*)malloc(MAX_SCAN);
+    const char *ext = strrchr(filename, '.');
+    if (ext) ext++;	
+    if (!buf) {
+        fprintf(stderr, "detect_compressed_format: malloc failed\n");
+        return 0;
+    }
+    ssize_t r = read_prefix(filename, buf, MAX_SCAN);
+    if (r < 0) {
+        fprintf(stderr, "detect_compressed_format: open/read failed: %s\n", strerror(errno));
+        free(buf);
+        return 0;
+    }
+    if (r < 16) {
+        fprintf(stderr, "detect_compressed_format: file too small (%zd bytes)\n", r);
+        free(buf);
+        return 0;
+    }
+    size_t len = (size_t)r;
+
+    uint32_t sr=0, ch=0, frame_bytes=0, frame_dur_us=0;
+    if (strcasecmp(ext, "mp3") == 0) {
+    /* Try MP3 (scan past ID3) */
+    if (scan_mp3(buf, len, &sr, &ch, &frame_bytes, &frame_dur_us)) {
+        strlcpy(data->encoded.codec_name, "mp3", sizeof(data->encoded.codec_name));
+        data->encoded.sample_rate      = sr;
+        data->encoded.channels         = ch;
+        data->encoded.frame_size       = frame_bytes;
+        data->encoded.frame_duration_us= frame_dur_us;
+        free(buf);
+        return 1;
+    }
+   
+    } else if (strcasecmp(ext, "aac") == 0) {
+   /* Try AAC ADTS anywhere */
+    if (scan_aac_adts(buf, len, &sr, &ch, &frame_bytes, &frame_dur_us)) {
+        strlcpy(data->encoded.codec_name, "aac", sizeof(data->encoded.codec_name));
+        data->encoded.sample_rate      = sr;
+        data->encoded.channels         = ch;
+        data->encoded.frame_size       = frame_bytes;
+        data->encoded.frame_duration_us= frame_dur_us;
+        free(buf);
+        return 1;
+    }
+    } else if (strcasecmp(ext, "flac") == 0) { 
+    /* Try FLAC */
+    if (scan_flac(buf, len, &sr, &ch, &frame_bytes, &frame_dur_us)) {
+        strlcpy(data->encoded.codec_name, "flac", sizeof(data->encoded.codec_name));
+        data->encoded.sample_rate      = sr;
+        data->encoded.channels         = ch;
+        data->encoded.frame_size       = frame_bytes;
+        data->encoded.frame_duration_us= frame_dur_us;
+        free(buf);
+        return 1;
+    }
+    } else if (strcasecmp(ext, "opus") == 0) {
+    /* Try Opus (Ogg) */
+    if (scan_opus(buf, len, &sr, &ch, &frame_bytes, &frame_dur_us)) {
+        strlcpy(data->encoded.codec_name, "opus", sizeof(data->encoded.codec_name));
+        data->encoded.sample_rate      = sr;
+        data->encoded.channels         = ch;
+        data->encoded.frame_size       = frame_bytes;
+        data->encoded.frame_duration_us= frame_dur_us;
+        free(buf);
+        return 1;
+    }
+    } else  {
+    /* Try Vorbis (Ogg) */
+    if (scan_vorbis(buf, len, &sr, &ch, &frame_bytes, &frame_dur_us)) {
+        strlcpy(data->encoded.codec_name, "vorbis", sizeof(data->encoded.codec_name));
+        data->encoded.sample_rate      = sr;
+        data->encoded.channels         = ch;
+        data->encoded.frame_size       = frame_bytes;
+        data->encoded.frame_duration_us= frame_dur_us;
+        free(buf);
+        return 1;
+    }
+	}
+    free(buf);
+    fprintf(stderr, "detect_compressed_format: unsupported format\n");
+    return 0;
+}
