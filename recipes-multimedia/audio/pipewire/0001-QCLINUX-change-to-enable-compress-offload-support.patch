+static int encoded_playback_fill(struct data *d, void *dest,
+                                 unsigned int n_frames, bool *null_frame)
+{
+    const uint32_t frame_size = d->encoded.frame_size;
+    const uint32_t sample_rate = d->encoded.sample_rate;
+    const uint32_t frame_dur_us = d->encoded.frame_duration_us;
+    int64_t quantum_us = 0;
+
+    if (sample_rate == 0 || frame_size == 0) {
+        fprintf(stderr, "encoded_fill: invalid sample_rate=%u or frame_size=%u\n",
+                sample_rate, frame_size);
+        *null_frame = true;
+        return 0;
+    }
+
+    if (n_frames > 0)
+        quantum_us = ((int64_t)n_frames * 1000000LL) / sample_rate;
+
+    if (quantum_us > 0 &&
+        d->encoded.accumulated_excess_playtime >= quantum_us) {
+        fprintf(stderr,
+                "Skipping cycle to compensate excess playtime (excess: %" PRId64 " us, quantum: %" PRId64 " us)\n",
+                d->encoded.accumulated_excess_playtime, quantum_us);
+        d->encoded.accumulated_excess_playtime -= quantum_us;
+        if (d->encoded.accumulated_excess_playtime < 0)
+            d->encoded.accumulated_excess_playtime = 0;
+        *null_frame = true;
+        return 0;
+    }
+
+    int ret = read(d->encoded.fd, dest, frame_size);
+    if (ret <= 0) {
+        fprintf(stderr, "encoded_fill: no encoded data or EOF\n");
+        *null_frame = true;
+        return 0;
+    }
+
+    if (quantum_us > 0 && frame_dur_us > quantum_us)
+        d->encoded.accumulated_excess_playtime += (frame_dur_us - quantum_us);
+
+    return ret; /* bytes read */
+}
+static int setup_encodedfile(struct data *data, const char *filename) {
+    /* Detect codec and initialize encoded fields */
+    if (!detect_compressed_format(data, filename)) {
+        fprintf(stderr, "Unsupported or unrecognized compressed format for '%s'\n", filename);
+        return -1;
+    }
+
+    /* Validate essential fields */
+    if (data->encoded.sample_rate == 0 ||
+        data->encoded.channels == 0 ||
+        data->encoded.frame_size == 0 ||
