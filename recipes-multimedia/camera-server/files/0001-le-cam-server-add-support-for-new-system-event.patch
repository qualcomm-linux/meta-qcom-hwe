+      // If there is a in-flight request, wait until it is submitted to HAL.
+      ret = cond_wait_relative(&current_request_signal_, &lock_, CLEAR_TIMEOUT);
+      if (-ETIMEDOUT == ret) {
+        break;
+      }
     }
   }
 
